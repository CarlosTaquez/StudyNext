{
  "name": "studynext",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build:scripts": "npm run build:dashboard && npm run build:academic",
    "build:dashboard": "tsc -p tsconfig.dashboard.json",
    "build:academic": "tsc -p tsconfig.academic.json",
    "prestart": "npm run build:scripts",
    "start": "ng serve",
    "prebuild": "npm run build:scripts",
    "build": "ng build",
    "prewatch": "npm run build:scripts",
    "watch": "ng build --watch --configuration development",
    "watch:academic": "tsc -p tsconfig.academic.json --watch",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.6.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/fire": "^21.0.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "firebase": "^12.18.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.22",
    "@angular/cli": "^21.2.22",
    "@angular/compiler-cli": "^21.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
